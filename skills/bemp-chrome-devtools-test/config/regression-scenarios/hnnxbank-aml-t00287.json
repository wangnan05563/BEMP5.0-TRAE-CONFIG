{
  "_doc": "T00287 回归场景：买入（转贴现买入）场景交易对手预检弹窗提示。核心验证点——买入明细行按真实数据形态不携带 saleBrchName（func_queryRebuyBillList 的 RebuyBillDto 无该字段），预检入参 oppName 必须由页面回退到批次层 formItem.saleBrchName（TE_REBUY_BATCH.SALE_BRCH_NAME）提供；不回退则 oppName 恒空、交易对手只剩 commit 保底拦截（无弹窗）。脚本零硬编码，全部要素取自本文件。",

  "scenario_id": "hnnxbank-aml-t00287",
  "description": "T00287 买入场景交易对手预检提示：明细行无 saleBrchName 时以批次对手名命中并弹窗",

  "env": {
    "frontend_url": "http://${ENV:BEMP_HOST}:${ENV:BEMP_FRONTEND_PORT:8091}",
    "account_role": "default",
    "viewport": { "width": 1600, "height": 900 },
    "headless": true
  },

  "navigation": {
    "menu_path": ["场内交易子系统", "市场交易", "对话报价", "对话报价申请"],
    "target_url_fragment": "#/be/market/quote/quoteManager",
    "leaf_dump_fallback": true
  },

  "target_component": {
    "manager": "quoteManager",
    "dialog": "quoteRebuyChange",
    "datagrid_ref": "billDatagrid",
    "open_strategy": "component_state",
    "open_state": {
      "busiType": "00101002",
      "trDir": "TDD01",
      "batchId": 1,
      "title": "报价修改",
      "closeWins": ["quoteSaleChangeWin"],
      "openWin": "quoteRebuyChangeWin"
    }
  },

  "data_strategy": "memory_inject",
  "_doc_data_strategy": "提交动作被预检中断，无真实状态流转，memory_inject 即可且无脏数据",

  "console_noise_extra": ["REQFAIL.*CLodopfuncs"],

  "cases": [
    {
      "id": "T00287-OPP-NAME-FALLBACK",
      "title": "明细行 saleBrchName 为空（真实形态）时，预检以批次 formItem.saleBrchName 命中交易对手并弹窗明细",
      "inject_form": {
        "_doc": "批次层交易对手为卖方机构，落地为 TE_REBUY_BATCH.SALE_BRCH_NAME；该值在名单内且其机构信用代码不在名单，故仅名称轮可命中",
        "saleBrchName": "AML-RBUY-对手测试机构甲",
        "saleBrchCode": "000000126"
      },
      "inject_row": {
        "_doc": "saleBrchName 显式置空：复现明细 DTO 不装载该字段的真实数据形态；firstPayInterest 非 0 以通过零利息前置校验",
        "billNo": "530758400799820250624666974792",
        "billRangeStart": 1,
        "billRangeEnd": 1008600,
        "drwrName": "河南对照客户R7测试有限公司",
        "acptBankName": "平安银行股份有限公司",
        "discBankName": "招商银行股份有限公司票据业务部",
        "firstPayInterest": 1000,
        "saleBrchName": ""
      },
      "trigger": {
        "method": "component_call_with_response",
        "target": "apply",
        "response_url_contains": "func_antiMoneyPreCheck",
        "response_timeout_ms": 30000
      },
      "assert": {
        "dialog_selector": ".h-form-table-layer",
        "dialog_text_contains": ["交易对手", "AML-RBUY-对手测试机构甲"],
        "highlight": {
          "selector": ".anti-money-hit-name",
          "match_text": "AML-RBUY-对手测试机构甲",
          "rgb_contains": "212, 56, 13"
        }
      },
      "screenshot": "t00287_opp_name_fallback"
    }
  ],

  "output": {
    "shot_dir": "aotutests-devtools/shots/${scenario_id}",
    "log_file": "aotutests-devtools/logs/${scenario_id}_log.txt"
  },

  "cleanup": {
    "close_calls": ["onAntiMoneyDialogClose"],
    "click_buttons": ["关 闭", "关闭", "我知道了", "确定"],
    "_doc": "预检命中即阻断提交，无真实提交产生，清理仅关闭弹窗"
  }
}