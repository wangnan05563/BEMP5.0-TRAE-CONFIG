{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "SQL执行策略配置 - 控制执行行为、超时、回退等策略（支持Oracle和MySQL）",
    "version": "2.4.0",
    "lastUpdate": "2026-05-24",
    "execution": {
        "oracle": {
            "ddlTimeout": 60,
            "dmlTimeout": 30,
            "queryTimeout": 120,
            "maxRetries": 3,
            "retryInterval": 5,
            "autoCommit": false,
            "affectRowLimit": 10000,
            "statementSeparator": ";",
            "skipEmptyLines": true,
            "skipCommentLines": true,
            "dmlViaMcp": false,
            "ddlViaMcp": false
        },
        "mysql": {
            "ddlTimeout": 60,
            "dmlTimeout": 30,
            "queryTimeout": 120,
            "maxRetries": 3,
            "retryInterval": 5,
            "autoCommit": true,
            "dryRun": false,
            "affectRowLimit": 10000,
            "statementSeparator": ";",
            "skipEmptyLines": true,
            "skipCommentLines": true,
            "dmlViaMcp": true,
            "ddlViaMcp": true,
            "safeExecutionMode": {
                "description": "安全执行模式 - 使用事务包裹DML操作，验证后提交，失败自动回滚",
                "enabled": true,
                "startTransaction": "START TRANSACTION",
                "commitOnVerifyPass": true,
                "rollbackOnFailure": true,
                "rollbackOnVerifyFail": true,
                "applicableTo": ["DML"],
                "notApplicableTo": ["DDL", "SELECT"],
                "note": "DDL语句在MySQL中会隐式提交，无法被ROLLBACK回滚"
            }
        }
    },
    "autoDetection": {
        "description": "数据库类型自动检测策略 - 当db-config.json中defaultDbType为auto时启用",
        "enabled": true,
        "timeoutPerProbeSeconds": 10,
        "oracleProbeTool": "mcp_oracle-mcp_list_schemas",
        "mysqlProbeSql": "SELECT 1 AS db_type_probe",
        "onBothAvailable": "usePriority",
        "onNeitherAvailable": "abort",
        "cacheDetectionResult": true,
        "note": "自动检测通过探测MCP工具可用性来判断数据库类型，不依赖配置文件中的连接参数"
    },
    "versionDetection": {
        "description": "数据库版本检测策略 - 连接建立后自动检测数据库版本，用于特性兼容性判断",
        "enabled": true,
        "oracleVersionQuery": "SELECT BANNER AS version FROM V$VERSION WHERE ROWNUM = 1",
        "mysqlVersionQuery": "SELECT VERSION() AS version, @@sql_mode AS sql_mode",
        "warnOnUnsupportedVersion": true,
        "blockOnIncompatibleFeature": true,
        "note": "版本检测结果用于与version-compat.json中的兼容性矩阵比对，自动调整可用特性"
    },
    "batchOperation": {
        "description": "批量操作策略 - 支持多脚本顺序执行、进度跟踪、部分失败处理",
        "enabled": true,
        "maxBatchSize": 20,
        "stopOnFailure": true,
        "executionOrder": ["ddl", "dml", "config"],
        "safeModeForBatch": true,
        "generateBatchReport": true,
        "progressTracking": true,
        "batchRollbackStrategy": "all_or_nothing",
        "note": "batchRollbackStrategy: all_or_nothing表示任一脚本失败则回退所有已执行的DML；best_effort表示仅回退失败脚本"
    },
    "encodingCheck": {
        "description": "编码检查与初始化策略 - 解决中文乱码问题",
        "enabled": true,
        "checkBeforeExecution": true,
        "initEncodingOnConnect": true,
        "oracle": {
            "initSqls": [
                "ALTER SESSION SET NLS_DATE_FORMAT = 'YYYY-MM-DD HH24:MI:SS'",
                "ALTER SESSION SET NLS_TIMESTAMP_FORMAT = 'YYYY-MM-DD HH24:MI:SS.FF'",
                "ALTER SESSION SET NLS_DATE_LANGUAGE = 'AMERICAN'",
                "ALTER SESSION SET NLS_LANGUAGE = 'AMERICAN'"
            ],
            "verifySql": "SELECT VALUE FROM NLS_SESSION_PARAMETERS WHERE PARAMETER = 'NLS_DATE_FORMAT'",
            "nlsLangEnvVar": "AMERICAN_AMERICA.AL32UTF8",
            "note": "NLS_LANG需在MCP服务端启动前设置，ALTER SESSION仅影响当前会话的日期格式"
        },
        "mysql": {
            "initSqls": [
                "SET NAMES utf8mb4",
                "SET CHARACTER_SET_CLIENT = utf8mb4",
                "SET CHARACTER_SET_CONNECTION = utf8mb4",
                "SET CHARACTER_SET_RESULTS = utf8mb4"
            ],
            "verifySql": "SELECT @@character_set_results AS results_charset",
            "expectedCharset": "utf8mb4",
            "note": "每次MCP连接后应先执行SET NAMES utf8mb4，确保会话编码正确"
        },
        "terminal": {
            "codePage": 65001,
            "initCommands": [
                "chcp 65001 > $null 2>&1",
                "[Console]::OutputEncoding = [System.Text.Encoding]::UTF8",
                "[Console]::InputEncoding = [System.Text.Encoding]::UTF8",
                "$OutputEncoding = [System.Text.Encoding]::UTF8"
            ],
            "note": "Windows PowerShell终端默认使用GBK(936)，需切换为UTF-8(65001)"
        }
    },
    "cliExecution": {
        "description": "命令行执行策略 - Oracle DML/DDL通过sqlplus执行，MySQL CLI作为备选",
        "oracle": {
            "enabled": true,
            "tool": "sqlplus",
            "script": "scripts/execute-oracle-sql.ps1",
            "autoSetNlsLang": true,
            "silenceMode": true,
            "errorPatterns": ["ORA-\\d{5}", "SP2-\\d{4}"],
            "note": "Oracle MCP仅支持SELECT，DML/DDL必须通过sqlplus命令行执行"
        },
        "mysql": {
            "enabled": true,
            "tool": "mysql",
            "script": "scripts/execute-mysql-sql.ps1",
            "defaultCharset": "utf8mb4",
            "errorPatterns": ["ERROR \\d{4}"],
            "note": "MySQL MCP已支持DML/DDL，CLI作为大数据量脚本或MCP不可用时的备选方案"
        }
    },
    "connectionKeepAlive": {
        "description": "连接保活与自动重连配置 - 防止长时间操作时连接断开",
        "enabled": true,
        "intervalSeconds": 300,
        "checkSql": "SELECT 1",
        "maxReconnectAttempts": 3,
        "reconnectIntervalSeconds": 5,
        "reconnectableErrorCodes": [2006, 2013, 1040],
        "note": "intervalSeconds应小于MySQL的wait_timeout（默认28800秒=8小时）"
    },
    "preCheck": {
        "enabled": true,
        "checkSyntax": true,
        "checkWhereClause": true,
        "checkIdempotent": true,
        "checkTableExists": true,
        "checkAffectRows": true,
        "affectRowWarningThreshold": 1000,
        "affectRowAbortThreshold": 10000,
        "mysql": {
            "checkEngine": true,
            "checkCharset": true,
            "checkAutoIncrement": true,
            "checkSqlCompatibility": true
        }
    },
    "verification": {
        "enabled": true,
        "verifyAfterDdl": true,
        "verifyAfterDml": true,
        "verifyInsertData": true,
        "verifyUpdateData": true,
        "verifyDeleteData": true,
        "snapshotBeforeExecute": true,
        "mysql": {
            "verifyEngine": false,
            "verifyCharset": false,
            "verifyAutoIncrement": true
        }
    },
    "rollback": {
        "strategy": "auto",
        "level": "script",
        "backupBeforeExecute": true,
        "generateRollbackScript": true,
        "rollbackOnFailure": true,
        "rollbackOnVerifyFail": true,
        "maxRollbackRetries": 2,
        "mysql": {
            "useTransactionRollback": true,
            "cascadeDrop": false,
            "preferRollbackOverScript": true,
            "rollbackPriorityDescription": "安全执行模式下优先使用ROLLBACK回滚事务，仅普通模式使用回退SQL脚本"
        }
    },
    "logging": {
        "level": "INFO",
        "logExecution": true,
        "logVerification": true,
        "logRollback": true,
        "logToFile": false,
        "logFilePath": "logs/db-operator/",
        "includeDbType": true,
        "logKeepAlive": true,
        "logFormat": {
            "description": "日志格式模板 - {timestamp} {dbType} {operationType} 等为占位符",
            "execution": "[{timestamp}] [{dbType}] [执行] [{scriptFile}] [{status}] [影响{affectedRows}行] [耗时{duration}ms]",
            "verification": "[{timestamp}] [{dbType}] [复核] [{verifySql}] [预期:{expected}] [实际:{actual}] [{match}]",
            "rollback": "[{timestamp}] [{dbType}] [回退] [{rollbackMethod}] [{status}] [回退{affectedRows}行]",
            "keepAlive": "[{timestamp}] [{dbType}] [保活] [{checkSql}] [连接状态:{connectionStatus}]"
        }
    },
    "mysqlErrorCodes": {
        "description": "MySQL异常错误码映射 - 用于步骤8异常处理",
        "constraintErrors": [
            {"code": 1062, "name": "ER_DUP_ENTRY", "description": "主键冲突/唯一约束违反", "safeModeAction": "ROLLBACK", "normalModeAction": "停止执行"},
            {"code": 1451, "name": "ER_ROW_IS_REFERENCED", "description": "外键约束-子记录存在", "safeModeAction": "ROLLBACK", "normalModeAction": "停止执行"},
            {"code": 1452, "name": "ER_NO_REFERENCED_ROW", "description": "外键约束-父记录不存在", "safeModeAction": "ROLLBACK", "normalModeAction": "停止执行"}
        ],
        "schemaErrors": [
            {"code": 1054, "name": "ER_BAD_FIELD_ERROR", "description": "字段不存在", "safeModeAction": "ROLLBACK", "normalModeAction": "停止执行"},
            {"code": 1146, "name": "ER_NO_SUCH_TABLE", "description": "表不存在", "safeModeAction": "ROLLBACK", "normalModeAction": "停止执行"}
        ],
        "connectionErrors": [
            {"code": 2006, "name": "CR_SERVER_GONE_ERROR", "description": "服务器已断开", "action": "自动重连后重试当前SQL"},
            {"code": 2013, "name": "CR_SERVER_LOST", "description": "查询过程中连接丢失", "action": "自动重连后重试当前SQL"},
            {"code": 1040, "name": "ER_CON_COUNT_ERROR", "description": "连接数过多", "action": "等待后重连"}
        ]
    },
    "dataExport": {
        "description": "数据导出配置 - S11场景",
        "formats": [
            {"name": "md", "extension": ".md", "description": "数据报告、文档交付", "features": "含表结构+数据+说明，适合人工阅读"},
            {"name": "csv", "extension": ".csv", "description": "数据分析、Excel导入", "features": "纯数据格式，适合程序处理"},
            {"name": "json", "extension": ".json", "description": "程序集成、API对接", "features": "结构化数据，适合自动化流程"}
        ],
        "pagination": {
            "noPaginationThreshold": 1000,
            "paginationThreshold": 10000,
            "pageSize": 1000,
            "cliExportThreshold": 10000,
            "note": "超过cliExportThreshold行时建议使用export-db-data.ps1命令行导出"
        },
        "timeRangeQueries": {
            "oracle_number_type": "SELECT * FROM {TABLE_NAME} WHERE TO_DATE(TO_CHAR({TIME_FIELD}), 'YYYYMMDDHH24MISSFF') >= SYSDATE - {DAYS} ORDER BY {TIME_FIELD} DESC",
            "oracle_date_type": "SELECT * FROM {TABLE_NAME} WHERE {TIME_FIELD} >= SYSDATE - {DAYS} ORDER BY {TIME_FIELD} DESC",
            "mysql": "SELECT * FROM {TABLE_NAME} WHERE {TIME_FIELD} >= DATE_SUB(NOW(), INTERVAL {DAYS} DAY) ORDER BY {TIME_FIELD} DESC",
            "note": "BEMP系统中时间字段可能存储为NUMBER类型(格式YYYYMMDDHH24MISSFF)，需先确认字段类型再选择正确的查询模板"
        }
    },
    "connectionFailure": {
        "description": "连接失败处理策略 - 步骤2连接验证失败时使用",
        "strategies": [
            {"failureType": "网络超时", "oracleAction": "检查网络连通性", "mysqlAction": "检查网络连通性"},
            {"failureType": "认证失败", "oracleAction": "检查用户名密码", "mysqlAction": "检查用户名密码"},
            {"failureType": "服务不可用", "oracleAction": "检查Oracle服务状态", "mysqlAction": "检查MySQL服务状态"},
            {"failureType": "Schema/DB不存在", "oracleAction": "检查Schema名称", "mysqlAction": "检查数据库名称"},
            {"failureType": "连接断开", "oracleAction": "重连后重试", "mysqlAction": "自动重连（见步骤10）"}
        ]
    },
    "levelDescriptions": {
        "statement": "单语句回退 - 仅回退失败的SQL语句",
        "script": "脚本级回退 - 回退整个脚本内的所有变更",
        "full": "全量回退 - 恢复到执行前的完整数据快照"
    }
}
