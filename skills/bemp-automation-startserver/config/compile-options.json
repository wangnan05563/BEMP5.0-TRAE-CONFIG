{
  "_doc": "增量编译模式配置 - 根据修改文件自动确定Maven编译范围，避免全量编译耗时过长（F-03改进：全量14分钟→增量预计2-4分钟）",
  "_ref": "路径与模块前缀引用 _shared/env-config.json，通过 ${ENV:} 占位符解析。与 compile-deploy.json 的模块定义保持一致",
  "_inheritance": {
    "_doc": "配置继承优先级：defaults → overrides.project → overrides.banks.{bankCode}，深度合并，后者覆盖前者同名键",
    "mergeRule": "deep-merge-last-wins",
    "bankKey": "${ENV:BANK_CODE}",
    "levels": [
      "defaults（技能级默认，本文件）",
      "overrides.project（项目级覆盖，按项目特性调整）",
      "overrides.banks.{bankCode}（银行级覆盖，按银行差异调整）"
    ]
  },

  "defaults": {
    "_doc": "编译默认参数，所有银行共享",
    "defaultMode": "incremental",
    "modes": {
      "full": {
        "_doc": "全量编译：编译整个reactor，最可靠但耗时最长",
        "command": "clean install -DskipTests=true",
        "timeoutSeconds": 1800,
        "useCase": "首次构建/依赖变更/不确定改动范围/CI构建"
      },
      "incremental": {
        "_doc": "增量编译：仅编译改动模块及其上游依赖(-am)，通过moduleMapping确定范围",
        "command": "clean install -DskipTests=true -pl {modules} -am",
        "timeoutSeconds": 600,
        "useCase": "日常开发，已知改动模块",
        "modulePlaceholder": "{modules}",
        "_note": "{modules}占位符在执行时替换为逗号分隔的模块路径，如 {modulePrefix}biz-as,{modulePrefix}served-deploy"
      },
      "skip": {
        "_doc": "跳过Maven编译：直接使用已有WAR产物启动（配合 -QuickStart）",
        "command": null,
        "timeoutSeconds": 0,
        "useCase": "仅前端改动、或确认代码已编译、或仅配置/资源文件变更"
      }
    },
    "modeSelection": {
      "_doc": "自动模式选择逻辑：根据git diff结果推断编译模式。显式指定时优先于自动推断",
      "rules": [
        {
          "condition": "无Java文件改动（仅前端/资源/配置）",
          "mode": "skip",
          "reason": "无需Maven编译，直接启动"
        },
        {
          "condition": "有Java文件改动且匹配moduleMapping规则",
          "mode": "incremental",
          "reason": "已知改动模块，增量编译"
        },
        {
          "condition": "有Java文件改动但未匹配任何moduleMapping规则",
          "mode": "full",
          "reason": "无法确定改动范围，回退全量编译保证完整性"
        }
      ]
    },
    "skipMavenForTypes": ["frontend"],
    "mavenExecutable": "${ENV:MAVEN_PATH}",
    "mavenSettings": "${ENV:MAVEN_SETTINGS}",
    "repoRoot": "${ENV:BEMP_WORKSPACE_ROOT}\\banks\\${ENV:BANK_PROJECT_DIR}",
    "gitDiffCommand": "git diff --name-only HEAD",
    "gitStatusCommand": "git status --short"
  },

  "moduleMapping": {
    "_doc": "文件路径glob模式→需编译的Maven模块列表。{modulePrefix}由BANK_MODULE_PREFIX解析。增量编译时按git diff结果匹配此表确定编译范围",
    "_matchRule": "按rules数组顺序匹配，首个命中的规则生效；未命中任何规则时回退到defaultMode=full",
    "rules": [
      {
        "id": "biz-as-to-served",
        "pattern": "**/${ENV:BANK_MODULE_PREFIX}biz-as/**/*.java",
        "modules": ["${ENV:BANK_MODULE_PREFIX}biz-as", "${ENV:BANK_MODULE_PREFIX}served-deploy"],
        "targetWar": "served",
        "description": "biz-as业务模块修改→联动编译served-deploy（业务逻辑需打入served WAR）"
      },
      {
        "id": "biz-bs-to-served",
        "pattern": "**/${ENV:BANK_MODULE_PREFIX}biz-bs/**/*.java",
        "modules": ["${ENV:BANK_MODULE_PREFIX}biz-bs", "${ENV:BANK_MODULE_PREFIX}served-deploy"],
        "targetWar": "served",
        "description": "biz-bs业务模块修改→联动编译served-deploy"
      },
      {
        "id": "biz-cs-to-served",
        "pattern": "**/${ENV:BANK_MODULE_PREFIX}biz-cs/**/*.java",
        "modules": ["${ENV:BANK_MODULE_PREFIX}biz-cs", "${ENV:BANK_MODULE_PREFIX}served-deploy"],
        "targetWar": "served",
        "description": "biz-cs业务模块修改→联动编译served-deploy"
      },
      {
        "id": "biz-ds-to-served",
        "pattern": "**/${ENV:BANK_MODULE_PREFIX}biz-ds/**/*.java",
        "modules": ["${ENV:BANK_MODULE_PREFIX}biz-ds", "${ENV:BANK_MODULE_PREFIX}served-deploy"],
        "targetWar": "served",
        "description": "biz-ds业务模块修改→联动编译served-deploy"
      },
      {
        "id": "adapter-as-to-adapter",
        "pattern": "**/${ENV:BANK_MODULE_PREFIX}adapter-as/**/*.java",
        "modules": ["${ENV:BANK_MODULE_PREFIX}adapter-as", "${ENV:BANK_MODULE_PREFIX}adapter-deploy"],
        "targetWar": "adapter",
        "description": "adapter-as适配器模块修改→联动编译adapter-deploy"
      },
      {
        "id": "served-deploy-self",
        "pattern": "**/${ENV:BANK_MODULE_PREFIX}served-deploy/**/*.java",
        "modules": ["${ENV:BANK_MODULE_PREFIX}served-deploy"],
        "targetWar": "served",
        "description": "served-deploy自身修改→仅编译served-deploy"
      },
      {
        "id": "adapter-deploy-self",
        "pattern": "**/${ENV:BANK_MODULE_PREFIX}adapter-deploy/**/*.java",
        "modules": ["${ENV:BANK_MODULE_PREFIX}adapter-deploy"],
        "targetWar": "adapter",
        "description": "adapter-deploy自身修改→仅编译adapter-deploy"
      },
      {
        "id": "frontend-skip",
        "pattern": "**/frontend/**",
        "modules": [],
        "targetWar": null,
        "description": "前端文件修改→跳过Maven编译（skipMavenForTypes=frontend）",
        "skipMaven": true
      }
    ],
    "_fallback": {
      "_doc": "通配回退规则：当具体规则未命中时，按模块名前缀推断目标WAR",
      "bizPattern": "*${ENV:BANK_MODULE_PREFIX}biz-*",
      "bizTargetModules": ["{matchedModule}", "${ENV:BANK_MODULE_PREFIX}served-deploy"],
      "adapterPattern": "*${ENV:BANK_MODULE_PREFIX}adapter-*",
      "adapterTargetModules": ["{matchedModule}", "${ENV:BANK_MODULE_PREFIX}adapter-deploy"]
    }
  },

  "overrides": {
    "_doc": "项目级和银行级覆盖配置。覆盖defaults和moduleMapping中的同名键",
    "project": {
      "_doc": "项目级覆盖：按项目特性调整编译参数（如超时、命令模板）。默认为空，按需填充"
    },
    "banks": {
      "_doc": "银行级覆盖：按银行差异调整模块映射或编译参数。key为银行code（BANK_CODE），默认为空",
      "_example": {
        "hnnxbank": {
          "defaults": {
            "incrementalCompileTimeout": 480
          }
        }
      }
    }
  }
}
