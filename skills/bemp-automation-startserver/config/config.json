{
  "_doc": "BEMP 服务启动统一配置（单一事实来源）。脚本零硬编码，所有参数在此 + local.json 管理。机器相关路径通过 ${local:dotted.path} 引用 local.json；银行/业务相关（模块名、端口、mainClass、JVM、编译模块）写在 profiles 下，便于切换不同银行。占位符支持 ${local:x.y}、${env:VAR}、${global.x}、${profiles.x.y}。",
  "defaultProfile": "hnnxxbank",
  "global": {
    "workspaceRoot": "${local:global.workspaceRoot}",
    "banksProjectPath": "${local:global.workspaceRoot}\\banks\\ext-hnnxbank",
    "frontendProjectPath": "${local:global.workspaceRoot}\\frontend",
    "javaHome": "${local:global.javaHome}",
    "nodePath": "${local:global.nodePath}",
    "mavenHome": "${local:global.mavenHome}",
    "mavenLocalRepo": "${local:global.mavenLocalRepo}",
    "logDir": "${local:global.logDir}"
  },
  "profiles": {
    "hnnxxbank": {
      "_doc": "河南农信 bank 开发环境。模块名/端口/mainClass 为本行逻辑；机器路径走 local.json。",
      "redis": {
        "exe": "${local:profiles.hnnxxbank.redis.exe}",
        "redisCli": "${local:profiles.hnnxxbank.redis.redisCli}",
        "dataDir": "${local:profiles.hnnxxbank.redis.dataDir}",
        "extraArgs": [],
        "postStart": [
          "CONFIG SET stop-writes-on-bgsave-error no"
        ]
      },
      "zookeeper": {
        "home": "${local:profiles.hnnxxbank.zookeeper.home}",
        "clientPort": 21811,
        "readinessWaitSec": 45,
        "env": { "JAVA_TOOL_OPTIONS": "-Dfile.encoding=UTF-8" }
      },
      "served": {
        "module": "hnnxbank-served-deploy",
        "warDir": "bemp-served",
        "mainClass": "com.hundsun.bemp.BempServedAppStarter",
        "jvmOptions": "-server -Xms1024m -Xmx2048m -XX:MetaspaceSize=256m -XX:MaxMetaspaceSize=512m",
        "compileModules": ["hnnxbank-served-deploy"]
      },
      "adapter": {
        "module": "hnnxbank-adapter-deploy",
        "warDir": "bemp-adapter",
        "mainClass": "com.hundsun.bemp.BempAdapterAppStarter",
        "jvmOptions": "-server -Xms512m -Xmx1024m -XX:MetaspaceSize=256m -XX:MaxMetaspaceSize=512m",
        "compileModules": ["hnnxbank-adapter-deploy"]
      },
      "frontend": {
        "startCommand": "run dev",
        "nodeMemoryLimitMb": 8192
      }
    }
  },
  "services": {
    "redis": {
      "enabled": true,
      "type": "redis",
      "port": 6379,
      "dependencies": [],
      "healthCheck": { "type": "port", "timeoutSec": 30 }
    },
    "zookeeper": {
      "enabled": true,
      "type": "zookeeper",
      "port": 21811,
      "dependencies": [],
      "healthCheck": { "type": "port", "timeoutSec": 60 }
    },
    "served": {
      "enabled": true,
      "type": "springboot",
      "port": 8010,
      "dependencies": ["redis", "zookeeper"],
      "healthCheck": { "type": "http", "path": "/", "expectedStatus": [200, 404], "timeoutSec": 600 }
    },
    "adapter": {
      "enabled": true,
      "type": "springboot",
      "port": 8090,
      "dependencies": ["redis", "zookeeper"],
      "healthCheck": { "type": "http", "path": "/", "expectedStatus": [200, 404], "timeoutSec": 600 }
    },
    "frontend": {
      "enabled": true,
      "type": "frontend",
      "port": 8091,
      "dependencies": [],
      "healthCheck": { "type": "http", "path": "/", "expectedStatus": [200], "timeoutSec": 600 }
    }
  },
  "launch": {
    "method": "wmi-detached",
    "readinessPollSec": 1,
    "healthCheckTimeoutSec": 300,
    "healthCheckRetries": 3,
    "fatalLogKeywords": ["ClassNotFoundException", "APPLICATION FAILED TO START", "BUILD FAILED", "javax.servlet.Filter"]
  },
  "compile": {
    "enabled": false,
    "skipIfBuilt": true,
    "mavenCommand": "install -DskipTests -am",
    "useLocalRepo": true
  }
}
