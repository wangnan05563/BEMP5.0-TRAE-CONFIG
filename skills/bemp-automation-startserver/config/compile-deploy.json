{
  "_doc": "Java源代码编译后自动部署到WAR包的配置。修改Java代码后，需编译+复制class+重启SpringBoot才能生效",
  "_ref": "所有路径和端口引用 _shared/env-config.json，通过 ${ENV:} 占位符解析",
  "javacPath": "${ENV:JAVA_HOME}\\bin\\javac",
  "workspaceRoot": "${ENV:BEMP_WORKSPACE_ROOT}",
  "bankProjectDir": "${ENV:BANK_PROJECT_DIR}",
  "modulePrefix": "${ENV:BANK_MODULE_PREFIX}",
  "modules": {
    "_pattern": "模块名={modulePrefix}biz-as|biz-bs|biz-cs|biz-ds，路径由 bankProjectDir + moduleName 动态拼接",
    "{modulePrefix}biz-as": {
      "sourceDir": "banks/ext-${ENV:BANK_PROJECT_DIR}/${ENV:BANK_MODULE_PREFIX}biz-as/src/main/java",
      "targetClassesDir": "banks/ext-${ENV:BANK_PROJECT_DIR}/${ENV:BANK_MODULE_PREFIX}biz-as/target/classes",
      "warClassesDir": "banks/ext-${ENV:BANK_PROJECT_DIR}/${ENV:BANK_MODULE_PREFIX}served-deploy/target/bemp-served/WEB-INF/classes",
      "warLibDir": "banks/ext-${ENV:BANK_PROJECT_DIR}/${ENV:BANK_MODULE_PREFIX}served-deploy/target/bemp-served/WEB-INF/lib"
    },
    "{modulePrefix}biz-bs": {
      "sourceDir": "banks/ext-${ENV:BANK_PROJECT_DIR}/${ENV:BANK_MODULE_PREFIX}biz-bs/src/main/java",
      "targetClassesDir": "banks/ext-${ENV:BANK_PROJECT_DIR}/${ENV:BANK_MODULE_PREFIX}biz-bs/target/classes",
      "warClassesDir": "banks/ext-${ENV:BANK_PROJECT_DIR}/${ENV:BANK_MODULE_PREFIX}served-deploy/target/bemp-served/WEB-INF/classes",
      "warLibDir": "banks/ext-${ENV:BANK_PROJECT_DIR}/${ENV:BANK_MODULE_PREFIX}served-deploy/target/bemp-served/WEB-INF/lib"
    },
    "{modulePrefix}biz-cs": {
      "sourceDir": "banks/ext-${ENV:BANK_PROJECT_DIR}/${ENV:BANK_MODULE_PREFIX}biz-cs/src/main/java",
      "targetClassesDir": "banks/ext-${ENV:BANK_PROJECT_DIR}/${ENV:BANK_MODULE_PREFIX}biz-cs/target/classes",
      "warClassesDir": "banks/ext-${ENV:BANK_PROJECT_DIR}/${ENV:BANK_MODULE_PREFIX}served-deploy/target/bemp-served/WEB-INF/classes",
      "warLibDir": "banks/ext-${ENV:BANK_PROJECT_DIR}/${ENV:BANK_MODULE_PREFIX}served-deploy/target/bemp-served/WEB-INF/lib"
    },
    "{modulePrefix}biz-ds": {
      "sourceDir": "banks/ext-${ENV:BANK_PROJECT_DIR}/${ENV:BANK_MODULE_PREFIX}biz-ds/src/main/java",
      "targetClassesDir": "banks/ext-${ENV:BANK_PROJECT_DIR}/${ENV:BANK_MODULE_PREFIX}biz-ds/target/classes",
      "warClassesDir": "banks/ext-${ENV:BANK_PROJECT_DIR}/${ENV:BANK_MODULE_PREFIX}served-deploy/target/bemp-served/WEB-INF/classes",
      "warLibDir": "banks/ext-${ENV:BANK_PROJECT_DIR}/${ENV:BANK_MODULE_PREFIX}served-deploy/target/bemp-served/WEB-INF/lib"
    }
  }
}
