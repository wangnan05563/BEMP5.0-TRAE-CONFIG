            "template_mode": "JSON_DIRECT_MODE",
            "applicable_banks": ["qinnbank"]
        }
    },
    "routing_mechanism": {
        "description": "消息路由机制",
        "formula": "bean名 = functionId + 'MessageConverter'",
        "flow": [
            "1. 外围系统发送MQ消息",
            "2. MqMessageInterceptor.preInvoke() 从报文提取msgCd",
            "3. 查FUNCTION_ID_MAP得到functionId",
            "4. Spring容器获取 functionId+'MessageConverter' 的bean",
            "5. 调用bean的fromMessage()解析报文",
            "6. 调用产品服务处理业务",
            "7. 调用bean的toMessage()组装响应"
        ],
        "function_id_map_registration": "各Converter的getFunctionIdMapping()在afterPropertiesSet()时注册到FUNCTION_ID_MAP"
    },
