    "test_must_rules": {
        "description": "测试编写强制约束（写入 SKILL.md 第 5 节）",
        "framework": "JUnit5 + Mockito + SpringBootTest",
        "rules": [
            "MUST 1: 每个 *MessageConverter.java 必须配套一个 *Test.java，与被测类同包",
            "MUST 2: 必须含 ≥1 个请求模拟报文 + ≥1 个应答模拟报文，存放在 src/test/resources/mock-msg/<converter-name>/ 下",
            "MUST 3: 测试必须使用 @SpringBootTest 真实 Spring 上下文 + @ActiveProfiles(test)",
            "MUST 4: 测试必须可直接在 IDE 中 Run，也支持 mvn test -Dtest=<ConverterName>Test",
            "MUST 5: 必须覆盖 入参解析 / 字段映射 / 应答拼装 / 异常分支 四个场景",
            "MUST 6: mock-msg 命名严格遵循 <bank>_<channel>_<func>_<biz>_<request|response>.{xml|json}",
            "MUST 7: 测试基类必须继承 references/test-template/AbstractAdapterConverterTest.java，按报文类型选子模板",
            "MUST 8: mock 报文必须包含真实业务字段值（禁止空 JSON {} 或占位符 xxx）",
            "MUST 9: 字段映射断言必须验证 ≥3 个核心业务字段（禁止只验证 retCode）"
        ],
        "coverage_threshold": {
            "line": ">= 70%",
            "branch": ">= 60%",
            "critical_methods": "100% (fromMessage / toMessage)"
        }
    },
    "mock_msg": {
        "description": "Mock-Msg 驱动开发配置",
        "base_dir": "src/test/resources/mock-msg",
        "encoding": "UTF-8",
        "path_template": "<base_dir>/<ConverterName>/<bank>_<channel>_<func>_<biz>_<type>.<ext>",
        "required_files": ["request", "response"],
        "file_ext_by_style": {
            "XML": "xml",
            "JSON_BASE": "json",
            "JSON_DIRECT": "json",
            "SERVER_XML+CLIENT_TCP_ESB": "xml",
            "SERVER_JSON+CLIENT_HTTP": "json",
            "SERVER_XML+CLIENT_MIXED": "xml"
        },
        "quality_rules": {
            "no_empty_json": true,
            "no_placeholder_values": true,
            "no_all_zero_values": true,
            "min_field_count": 3,
            "xml_must_have_header_comment": true
        },
        "fallback_strategy": {
            "no_mock_from_business": "从接口文档推断报文结构，标'待联调确认'",
            "no_interface_doc": "阻塞，等业务方提供",
            "response_format_uncertain": "参考同银行同通道已有 Converter 的响应格式"
        }
    }
}
