{
    "banks": {
        "hnnxbank": {
            "bank_name": "河南农商银行",
            "adapter_module": "hnnxbank-adapter-as",
            "package_prefix": "com.hundsun.bemp.hnnxbank.adapter.msg",
            "message_style": "XML",
            "style_detail": "XmlDocument/XmlNode解析XML报文，HeadUtils封装报文头",
            "base_class": "AbstractMessageApplyResponseConverter",
            "ext_service_code_pattern": "EBBS.{tx_code}.01",
            "interceptor_class": "MqMessageInterceptor",
            "modules": {
                "ecif": {
                    "description": "ECIF客户管理系统",
                    "service_prefix": "Ecif",
                    "dto_package": "ecif"
                },
                "credit": {
                    "description": "信贷系统",
                    "service_prefix": "Credit",
                    "dto_package": "credit"
                },
                "ebank": {
                    "description": "网银系统",
                    "service_prefix": "Ebank",
                    "dto_package": "ebank"
                },
                "approve": {
                    "description": "审批系统",
                    "service_prefix": "Approve",
                    "dto_package": "approve"
                }
            },
            "xml_parsing": {
                "style": "XmlDocument_XmlNode",
                "util_class": "XmlUtil",
                "head_util_class": "HeadUtils",
                "constants_class": "MessageConstants",
                "request_path": "body.request",
                "header_path": "header"
            },
            "header_handling": {
                "request_header_method": "HeadUtils.sysHeadToJson",
                "response_header_method": "HeadUtils.jsonToSysHead",
                "ecif_override_fields": {
                    "tellerNo": "Header.reqUserNo",
                    "orgCode": "Header.reqBrchNo"
                }
            },
            "test_config": {
                "framework": "JUnit4",
                "mock_framework": "Mockito",
                "spring_context": false,
                "test_directory": "src/test/java"
            },
            "validation": {
                "ide_diagnostics": true,
                "maven_compile": false
            }
        },
        "shaoxbank": {
            "bank_name": "绍兴银行",
            "adapter_module": "shaoxbank-adapter-as",
            "package_prefix": "com.hundsun.bemp.sxbank.adapter.msg",
            "message_style": "XML",
            "style_detail": "XmlDocument/XmlNode解析XML报文，与hnnxbank风格类似",
            "base_class": "AbstractMessageApplyResponseConverter",
            "ext_service_code_pattern": "EBBS.{tx_code}.01",
            "interceptor_class": "MqMessageInterceptor",
            "modules": {
                "ecif": {
                    "description": "ECIF客户管理系统",
                    "service_prefix": "Ecif",
                    "dto_package": "ecif"
                },
                "credit": {
                    "description": "信贷系统",
                    "service_prefix": "Credit",
                    "dto_package": "credit"
                }
            },
            "xml_parsing": {
                "style": "XmlDocument_XmlNode",
                "util_class": "XmlUtil",
                "head_util_class": "HeadUtils",
                "constants_class": "MessageConstants",
                "request_path": "body.request",
                "header_path": "header"
            },
            "header_handling": {
                "request_header_method": "HeadUtils.sysHeadToJson",
                "response_header_method": "HeadUtils.jsonToSysHead"
            },
            "test_config": {
                "framework": "JUnit4",
                "mock_framework": "Mockito",
                "spring_context": false,
                "test_directory": "src/test/java"
            },
            "validation": {
                "ide_diagnostics": true,
                "maven_compile": false
            }
        },
        "yibbank": {
            "bank_name": "宜宾银行",
            "adapter_module": "yibbank-adapter-as",
            "package_prefix": "com.hundsun.bemp.yibbank.adapter.msg",
            "message_style": "JSON_BASE",
            "style_detail": "JSON报文+YbinChannelBaseMessageApplyResponseConverter基类，大部分Converter为空壳",
            "base_class": "YbinChannelBaseMessageApplyResponseConverter",
            "ext_service_code_pattern": "{PICE_CODE}",
            "interceptor_class": "YbinTcpMessageInterceptor",
            "base_class_detail": {
                "fromMessage": "从payload提取body节点直接返回",
                "toMessage": "XmlUtil.buildSuccessMessage构建成功响应",
                "getFunctionIdMapping": "自动从类名提取PICE代码"
            },
            "modules": {
                "ebank": {
                    "description": "网银系统",
                    "service_prefix": "Ebank",
                    "dto_package": "ebank"
                },
                "credit": {
                    "description": "信贷系统",
                    "service_prefix": "Credit",
                    "dto_package": "credit"
                },
                "gm": {
                    "description": "公共管理",
                    "service_prefix": "Gm",
                    "dto_package": "gm"
                },
                "living": {
                    "description": "活体检测",
                    "service_prefix": "Living",
                    "dto_package": "living"
                }
            },
            "has_server_subdirectory": true,
            "has_client_subdirectory": true,
            "test_config": {
                "framework": "JUnit4",
                "mock_framework": "Mockito",
                "spring_context": false,
                "test_directory": "src/test/java"
            },
            "validation": {
                "ide_diagnostics": true,
                "maven_compile": false
            }
        },
        "qinnbank": {
            "bank_name": "秦皇岛银行",
            "adapter_module": "qinnbank-adapter-as",
            "package_prefix": "com.hundsun.bemp.qinnbank.adapter.msg",
            "message_style": "JSON_DIRECT",
            "style_detail": "JSON报文直通，无银行基类，每个Converter自行处理fromMessage/toMessage",
            "base_class": "AbstractMessageApplyResponseConverter",
            "ext_service_code_pattern": "{PICE_CODE}",
            "interceptor_class": "TcpMessageInterceptor",
            "modules": {
                "ebank": {
                    "description": "网银系统",
                    "service_prefix": "Ebank",
                    "dto_package": "ebank",
                    "sub_modules": ["fastdisc", "billpool"]
                },
                "credit": {
                    "description": "信贷系统",
                    "service_prefix": "Credit",
                    "dto_package": "credit"
                },
                "platform": {
                    "description": "平台",
                    "service_prefix": "Platform",
                    "dto_package": "platform"
                }
            },
            "has_server_subdirectory": true,
            "has_client_subdirectory": true,
            "client_tcp_base_classes": [
                "AbstractEsb1MessageRequestReplyConverter",
                "AbstractEsb2MessageRequestReplyConverter",
                "AbstractEsb3MessageRequestReplyConverter"
            ],
            "test_config": {
                "framework": "JUnit4",
                "mock_framework": "Mockito",
                "spring_context": false,
                "test_directory": "src/test/java"
            },
            "validation": {
                "ide_diagnostics": true,
                "maven_compile": false
            }
        }
    },
    "message_style_enum": {
        "XML": {
            "description": "XML报文模式，需XmlDocument/XmlNode解析",
            "template_mode": "XML_MODE",
            "applicable_banks": ["hnnxbank", "shaoxbank"]
        },
        "JSON_BASE": {
            "description": "JSON报文+银行基类模式，大部分空壳Converter",
            "template_mode": "JSON_BASE_MODE",
            "applicable_banks": ["yibbank"]
        },
        "JSON_DIRECT": {
            "description": "JSON报文直通模式，无基类，自行处理",
            "template_mode": "JSON_DIRECT_MODE",
            "applicable_banks": ["qinnbank"]
        }
    },
    "routing_mechanism": {
        "description": "消息路由机制",
        "formula": "bean名 = functionId + 'MessageConverter'",
        "flow": [
            "1. 外围系统发送MQ消息",
            "2. MqMessageInterceptor.preInvoke() 从报文提取msgCd",
            "3. 查FUNCTION_ID_MAP得到functionId",
            "4. Spring容器获取 functionId+'MessageConverter' 的bean",
            "5. 调用bean的fromMessage()解析报文",
            "6. 调用产品服务处理业务",
            "7. 调用bean的toMessage()组装响应"
        ],
        "function_id_map_registration": "各Converter的getFunctionIdMapping()在afterPropertiesSet()时注册到FUNCTION_ID_MAP"
    }
}
