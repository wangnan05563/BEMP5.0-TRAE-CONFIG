    "message_style_enum": {
        "XML": {
            "description": "XML报文模式，需XmlDocument/XmlNode解析，MessageXmlBuilder构建响应",
            "template_mode": "XML_MODE",
            "applicable_banks": ["hnnxbank", "shaoxbank", "huisbank", "jinzbank", "nmgbank", "huzbank", "hxbank", "fxbank", "tianjbank", "xxbank"]
        },
        "JSON_BASE": {
            "description": "JSON报文+银行基类模式，大部分空壳Converter",
            "template_mode": "JSON_BASE_MODE",
            "applicable_banks": ["yibbank"]
        },
        "JSON_DIRECT": {
            "description": "JSON报文直通模式，无基类，自行处理fromMessage/toMessage",
            "template_mode": "JSON_DIRECT_MODE",
            "applicable_banks": ["qinnbank"]
        }
    },
    "routing_mechanism": {
        "description": "消息路由机制",
        "formula": "bean名 = functionId + 'MessageConverter'",
        "flow": [
            "1. 外围系统发送MQ消息",
            "2. MqMessageInterceptor.preInvoke() 从报文提取msgCd",
            "3. 查FUNCTION_ID_MAP得到functionId",
            "4. Spring容器获取 functionId+'MessageConverter' 的bean",
            "5. 调用bean的fromMessage()解析报文",
            "6. 调用产品服务处理业务",
            "7. 调用bean的toMessage()组装响应"
        ],
        "function_id_map_registration": "各Converter的getFunctionIdMapping()在afterPropertiesSet()时注册到FUNCTION_ID_MAP"
    },
    "test_template": {
        "description": "测试类必须包含模拟报文，可独立执行",
        "xml_mode": "使用MessageXmlParser解析真实XML字符串，构造完整header+body+request结构",
        "json_mode": "使用JSONObject构造完整JSON payload，包含body和requestDto",
        "required_test_cases": [
            "testFromMessage_normal - 正常报文解析，验证所有字段映射",
            "testFromMessage_missingSubNodes - 子节点缺失容错，验证null检查",
            "testToMessage_normal - 正常响应组装，验证XML/JSON结构",
            "testToMessage_emptyRetData - 空retData容错，验证不抛异常",
            "testGetFunctionIdMapping - 映射关系验证"
        ]
    }
}