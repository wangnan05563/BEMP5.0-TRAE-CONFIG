{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "BEMP技能库全局环境配置 - 所有技能模块共享的环境参数集中管理",
  "version": "1.0.0",
  "usage": "各技能模块通过 _shared/Resolve-EnvConfig.ps1 引用此配置，支持 ${ENV:VAR_NAME} 环境变量占位符",

  "bank": {
    "code": "hnnxbank",
    "classPrefix": "Hnnx",
    "classNamePrefix": "HnnxBank",
    "schemaName": "BEMP_HNNX",
    "dbName": "bemp_hnnx",
    "projectDir": "ext-hnnxbank",
    "urlPrefix": "/hnnxbank/",
    "sonarProjectKey": "bemp-ext-hnnxbank",
    "sonarProjectName": "BEMP Ext HNNXBank",
    "modulePrefix": "hnnxbank-",
    "packagePrefix": "com.hundsun.bemp.hnnxbank",
    "batchTable": "HNNX_ACCBANK_CREDIT_BATCH",
    "infoTable": "HNNX_ACCBANK_CREDIT_INFO"
  },

  "paths": {
    "workspaceRoot": "${ENV:BEMP_WORKSPACE_ROOT}",
    "banksProjectPath": "${ENV:BEMP_WORKSPACE_ROOT}\\banks\\${ENV:BANK_PROJECT_DIR}",
    "frontendProjectPath": "${ENV:BEMP_WORKSPACE_ROOT}\\frontend",
    "traePath": "${ENV:TRAE_PATH}",
    "javaHome": "${ENV:JAVA_HOME}",
    "javaHomeForSonar": "${ENV:JAVA_HOME_SONAR}",
    "nodePath": "${ENV:NODE_PATH}",
    "mavenPath": "${ENV:MAVEN_PATH}",
    "jmeterPath": "${ENV:JMETER_PATH}",
    "redisExe": "${ENV:REDIS_EXE}",
    "zookeeperExe": "${ENV:ZOOKEEPER_EXE}",
    "sonarqubeHome": "${ENV:SONARQUBE_HOME}",
    "sonarScannerHome": "${ENV:SONAR_SCANNER_HOME}",
    "nginxHome": "${ENV:NGINX_HOME}",
    "deployDir": "${ENV:BEMP_DEPLOY_DIR}",
    "gitPath": "${ENV:GIT_PATH}"
  },

  "services": {
    "redis": { "port": 6379 },
    "zookeeper": { "port": 2181 },
    "springboot": { "port": 8010, "debugPort": 5005 },
    "frontend": { "port": 8091 },
    "sonarqube": { "port": 9000, "host": "http://localhost:9000" }
  },

  "database": {
    "oracle": {
      "host": "${ENV:ORACLE_HOST}",
      "port": 1521,
      "serviceName": "${ENV:ORACLE_SERVICE}",
      "username": "${ENV:ORACLE_USERNAME}",
      "password": "${ENV:ORACLE_PASSWORD}",
      "schema": "${ENV:ORACLE_SCHEMA}"
    },
    "mysql": {
      "host": "${ENV:MYSQL_HOST}",
      "port": 3306,
      "database": "${ENV:MYSQL_DATABASE}",
      "username": "${ENV:MYSQL_USERNAME}",
      "password": "${ENV:MYSQL_PASSWORD}"
    }
  },

  "testAccounts": {
    "passwordEnvVar": "BEMP_TEST_PASSWORD",
    "note": "测试账号密码统一通过 BEMP_TEST_PASSWORD 环境变量注入，配置文件中使用 ${ENV:BEMP_TEST_PASSWORD} 占位符"
  },

  "environmentDefaults": {
