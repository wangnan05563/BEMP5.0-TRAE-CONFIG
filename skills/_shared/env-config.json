{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "BEMP技能库全局环境配置 - 所有技能模块共享的环境参数集中管理",
  "version": "2.0.0",
  "changelog": "v2.0.0: HC-01敏感信息脱敏、HC-03银行配置动态化、HC-04端口环境变量化、HC-05测试账号统一化",
  "usage": "全技能库唯一配置入口：更换电脑/银行/配置信息只改本文件。各技能模块通过 _shared/Resolve-EnvConfig.ps1 引用，支持 ${ENV:VAR_NAME} 占位符，解析链 = 环境变量 > environmentDefaults。environmentDefaults 承载全部默认真值（路径类/银行类/连接类），敏感信息（密码）原则上也在此集中管理。",

  "_singleEntry": {
    "description": "单入口约定（2026-08-29 定案）",
    "rules": [
      "当前银行：只改 environmentDefaults.BANK_CODE 及 BANK_* 系列（或临时设置环境变量 $env:BANK_CODE）",
      "机器环境：只改 environmentDefaults 中 BEMP_WORKSPACE_ROOT/JAVA_HOME/NODE_PATH/MAVEN_*/REDIS_*/ZOOKEEPER_* 等路径",
      "数据库连接：只改 environmentDefaults 中 ORACLE_*/MYSQL_* 系列",
      "各技能配置文件一律用 ${ENV:VAR} 占位符引用本文件，禁止硬编码真值"
    ]
  },

  "bank": {
    "code": "${ENV:BANK_CODE}",
    "classPrefix": "${ENV:BANK_CLASS_PREFIX}",
    "classNamePrefix": "${ENV:BANK_CLASS_NAME_PREFIX}",
    "schemaName": "${ENV:BANK_DB_SCHEMA}",
    "dbName": "${ENV:BANK_DB_NAME}",
    "projectDir": "${ENV:BANK_PROJECT_DIR}",
    "urlPrefix": "${ENV:BANK_URL_PREFIX}",
    "sonarProjectKey": "${ENV:BANK_SONAR_PROJECT_KEY}",
    "sonarProjectName": "${ENV:BANK_SONAR_PROJECT_NAME}",
    "modulePrefix": "${ENV:BANK_MODULE_PREFIX}",
    "packagePrefix": "${ENV:BANK_PACKAGE_PREFIX}",
    "batchTable": "${ENV:BANK_BATCH_TABLE}",
    "infoTable": "${ENV:BANK_INFO_TABLE}"
  },

  "paths": {
    "workspaceRoot": "${ENV:BEMP_WORKSPACE_ROOT}",
    "banksProjectPath": "${ENV:BEMP_WORKSPACE_ROOT}\\banks\\${ENV:BANK_PROJECT_DIR}",
    "frontendProjectPath": "${ENV:BEMP_WORKSPACE_ROOT}\\frontend",
    "traePath": "${ENV:TRAE_PATH}",
    "javaHome": "${ENV:JAVA_HOME}",
    "javaHomeForSonar": "${ENV:JAVA_HOME_SONAR}",
    "nodePath": "${ENV:NODE_PATH}",
    "nodeHome": "${ENV:NODE_HOME}",
    "mavenPath": "${ENV:MAVEN_PATH}",
    "mavenHome": "${ENV:MAVEN_HOME}",
    "mavenSettings": "${ENV:MAVEN_SETTINGS}",
    "jmeterPath": "${ENV:JMETER_PATH}",
    "redisExe": "${ENV:REDIS_EXE}",
    "zookeeperExe": "${ENV:ZOOKEEPER_EXE}",
    "sonarqubeHome": "${ENV:SONARQUBE_HOME}",
    "sonarScannerHome": "${ENV:SONAR_SCANNER_HOME}",
    "sonarScannerHomeFrontend": "${ENV:SONAR_SCANNER_HOME_FRONTEND}",
    "nginxHome": "${ENV:NGINX_HOME}",
    "deployDir": "${ENV:BEMP_DEPLOY_DIR}",
    "gitPath": "${ENV:GIT_PATH}"
  },

  "services": {
    "redis": { "port": "${ENV:BEMP_REDIS_PORT:6379}" },
    "zookeeper": { "port": "${ENV:BEMP_ZK_PORT:2181}" },
    "springboot": { "port": "${ENV:BEMP_BACKEND_PORT:8010}", "debugPort": "${ENV:BEMP_DEBUG_PORT:5005}" },
    "frontend": { "port": "${ENV:BEMP_FRONTEND_PORT:8091}" },
    "sonarqube": { "port": "${ENV:SONARQUBE_PORT:9000}", "host": "http://${ENV:BEMP_HOST:127.0.0.1}:${ENV:SONARQUBE_PORT:9000}" }
  },

  "database": {
    "oracle": {
      "host": "${ENV:ORACLE_HOST}",
      "port": "${ENV:ORACLE_PORT:1521}",
      "serviceName": "${ENV:ORACLE_SERVICE}",
      "username": "${ENV:ORACLE_USERNAME}",
      "password": "${ENV:ORACLE_PASSWORD}",
      "schema": "${ENV:ORACLE_SCHEMA}",
      "dsn": "${ENV:ORACLE_DSN}"
    },
    "mysql": {
      "host": "${ENV:MYSQL_HOST}",
      "port": "${ENV:MYSQL_PORT:3306}",
      "database": "${ENV:MYSQL_DATABASE}",
      "username": "${ENV:MYSQL_USERNAME}",
      "password": "${ENV:MYSQL_PASSWORD}",
      "dsn": "${ENV:MYSQL_DSN}"
    }
  },

  "testAccounts": {
    "passwordEnvVar": "BEMP_TEST_PASSWORD",
    "note": "测试账号密码统一通过 BEMP_TEST_PASSWORD 环境变量注入。测试账号用户名通过环境变量配置，支持多角色。",
    "roles": {
      "default": {
        "usernameEnvVar": "BEMP_TEST_USER_DEFAULT",
        "description": "普通柜员账号"
      },
      "admin": {
        "usernameEnvVar": "BEMP_TEST_USER_ADMIN",
        "description": "法人管理员账号"
      },
      "branch_admin": {
        "usernameEnvVar": "BEMP_TEST_USER_BRANCH_ADMIN",
        "description": "机构管理员账号"
      }
    }
  },

  "environmentDefaults": {
